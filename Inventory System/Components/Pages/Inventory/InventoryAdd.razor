@page "/inventory/add"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject InventoryService InventoryService
@inject CategoryService CategoryService
@inject ToastService ToastService

<PageTitle>Add Product - Inventory System</PageTitle>

@if (AuthService.IsLoggedIn)
{
<div class="page-header">
    <div>
        <h1>Add New Product</h1>
        <p>Fill in the details to add a new product to inventory</p>
    </div>
    <div class="page-header-actions">
        <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/inventory")'>Cancel</button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <EditForm Model="product" OnValidSubmit="HandleSubmit">

            <div class="grid-2" style="margin-bottom: 0;">
                <div class="form-group">
                    <label>Product ID *</label>
                    <input type="text" class="form-control" value="@product.ProductId" readonly />
                </div>

                <div class="form-group">
                    <label>Product Name *</label>
                    <input type="text" class="form-control @(productNameError.Length > 0 ? "is-invalid" : "")"
                           placeholder="Enter product name" @bind="product.ProductName" @bind:event="oninput" />
                    @if (productNameError.Length > 0)
                    {
                        <div class="form-error">@productNameError</div>
                    }
                </div>

                <div class="form-group">
                    <label>Category *</label>
                    <select class="form-control @(categoryError.Length > 0 ? "is-invalid" : "")" @bind="product.Category" @bind:event="oninput">
                        <option value="">Select a category</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                    @if (categoryError.Length > 0)
                    {
                        <div class="form-error">@categoryError</div>
                    }
                </div>

                <div class="form-group">
                    <label>Price (₱) *</label>
                    <input type="number" class="form-control @(priceError.Length > 0 ? "is-invalid" : "")"
                           placeholder="0.00" @bind="product.Price" step="0.01" min="0" />
                    @if (priceError.Length > 0)
                    {
                        <div class="form-error">@priceError</div>
                    }
                </div>

                <div class="form-group">
                    <label>Quantity *</label>
                    <input type="number" class="form-control @(quantityError.Length > 0 ? "is-invalid" : "")"
                           placeholder="0" @bind="product.Quantity" min="0" />
                    @if (quantityError.Length > 0)
                    {
                        <div class="form-error">@quantityError</div>
                    }
                </div>

                <div class="form-group">
                    <label>Minimum Stock Level *</label>
                    <input type="number" class="form-control @(minStockError.Length > 0 ? "is-invalid" : "")"
                           placeholder="0" @bind="product.MinimumStockLevel" min="0" />
                    @if (minStockError.Length > 0)
                    {
                        <div class="form-error">@minStockError</div>
                    }
                </div>

                <div class="form-group">
                    <label>Unit *</label>
                    <input type="text" class="form-control @(unitError.Length > 0 ? "is-invalid" : "")"
                           placeholder="e.g. Piece, Bottle, Pack" @bind="product.Unit" @bind:event="oninput" />
                    @if (unitError.Length > 0)
                    {
                        <div class="form-error">@unitError</div>
                    }
                </div>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea class="form-control" rows="3" placeholder="Product description..." @bind="product.Description" style="resize:vertical;"></textarea>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/inventory")'>Cancel</button>
                <button type="submit" class="btn btn-primary">Add Product</button>
            </div>
        </EditForm>
    </div>
</div>

@if (showSuccessModal)
{
    <div class="modal-overlay">
        <div class="modal" style="max-width:400px;text-align:center;">
            <div class="modal-body" style="padding:32px 24px;">
                <div class="success-check" aria-hidden="true"><i class="bi bi-check-lg"></i></div>
                <h3 style="font-size:18px;font-weight:600;margin-bottom:8px;">Product Added Successfully!</h3>
                <p style="color:var(--text-secondary);font-size:14px;margin-bottom:24px;">The product has been added to the inventory.</p>
                <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
                    <button class="btn btn-secondary btn-sm" @onclick="AddAnotherProduct">Add Another Product</button>
                    <button class="btn btn-primary btn-sm" @onclick="GoToInventory">View Inventory</button>
                </div>
            </div>
        </div>
    </div>
}
}

@code {
    private Product product = new();
    private List<string> categories = new();
    private bool showSuccessModal;
    private string productNameError = string.Empty;
    private string categoryError = string.Empty;
    private string priceError = string.Empty;
    private string quantityError = string.Empty;
    private string minStockError = string.Empty;
    private string unitError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            await RedirectToLogin();
            return;
        }

        categories = CategoryService.GetAll();
        product.ProductId = InventoryService.GenerateNextProductId();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (redirectRequested)
        {
            redirectRequested = false;
            var nav = Navigation;
            if (nav != null)
            {
                nav.NavigateTo("/login", forceLoad: false);
            }
        }
    }

    private bool redirectRequested;

    private Task RedirectToLogin()
    {
        redirectRequested = true;
        return Task.CompletedTask;
    }

    private void HandleSubmit()
    {
        productNameError = string.Empty;
        categoryError = string.Empty;
        priceError = string.Empty;
        quantityError = string.Empty;
        minStockError = string.Empty;
        unitError = string.Empty;

        product.ProductId = InputValidator.TrimSpaces(product.ProductId);
        product.ProductName = InputValidator.TrimSpaces(product.ProductName);
        product.Category = InputValidator.TrimSpaces(product.Category);
        product.Unit = InputValidator.TrimSpaces(product.Unit);
        product.Description = InputValidator.TrimSpaces(product.Description);

        productNameError = InputValidator.RequiredError(product.ProductName, "Product name");
        categoryError = InputValidator.RequiredError(product.Category, "Category");
        unitError = InputValidator.RequiredError(product.Unit, "Unit");

        if (product.Price <= 0) { priceError = "Price must be greater than zero."; }
        if (product.Quantity < 0) { quantityError = "Quantity cannot be negative."; }
        if (product.MinimumStockLevel < 0) { minStockError = "Minimum stock cannot be negative."; }

        if (productNameError.Length > 0 ||
            categoryError.Length > 0 ||
            priceError.Length > 0 ||
            quantityError.Length > 0 ||
            minStockError.Length > 0 ||
            unitError.Length > 0)
        {
            return;
        }

        InventoryService.Add(product);
        ToastService.ShowSuccess($"'{product.ProductName}' has been added to inventory.");
        showSuccessModal = true;
    }

    private void AddAnotherProduct()
    {
        product = new Product { ProductId = InventoryService.GenerateNextProductId() };
        showSuccessModal = false;
        productNameError = string.Empty;
        categoryError = string.Empty;
        priceError = string.Empty;
        quantityError = string.Empty;
        minStockError = string.Empty;
        unitError = string.Empty;
    }

    private void GoToInventory()
    {
        Navigation.NavigateTo("/inventory");
    }
}